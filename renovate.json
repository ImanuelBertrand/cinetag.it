{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 4"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Keep the pyproject and pre-commit copies of ruff in lockstep",
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "description": "Keep the package.json and pre-commit copies of prettier in lockstep",
      "matchPackageNames": ["prettier", "prettier-plugin-jinja-template"],
      "groupName": "prettier"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js", "eslint-config-prettier", "globals"],
      "groupName": "eslint"
    },
    {
      "description": "Auto-merge non-major updates of linters that CI actually runs, once CI is green. pylint is excluded because CI runs it with --exit-zero.",
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff-pre-commit",
        "ty",
        "taplo",
        "prettier",
        "prettier-plugin-jinja-template",
        "eslint",
        "@eslint/js",
        "eslint-config-prettier",
        "globals"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
